# Copie para .env e preencha. Nunca faça commit do .env.

# Porta local onde o app fica disponível para o Nginx do servidor
RATEIOS_PORTA=8091

# Subcaminho no Nginx do servidor (https://servidor/rateios/). Vazio = raiz do domínio
VITE_BASE_PATH=rateios

# Tamanho máximo de cada arquivo enviado (MB)
LIMITE_UPLOAD_MB=50

# Supabase (opcional: só o botão "Validar conexão" usa)
SUPABASE_URL=
SUPABASE_ANON_KEY=
